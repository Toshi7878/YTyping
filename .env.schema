# 環境変数スキーマ（varlock）。値は書かず、型・必須条件・機密性だけを宣言する。実際の値は .env / .env.local / Vercel の環境変数で設定する
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix(NEXT_PUBLIC_)
# @generateTsTypes(path=./env.d.ts)
# ---

# 実行環境（Vercel の VERCEL_ENV から導出。Vercel 以外は development）
# @type=enum(development, preview, production)
# @public
APP_ENV=remap($VERCEL_ENV, "production", production, "preview", preview, development)

# Vercel が自動で設定する値
# @public
VERCEL=
# @type=enum(development, preview, production)
# @public
VERCEL_ENV=
# @public
VERCEL_URL=
# @public
VERCEL_PROJECT_PRODUCTION_URL=

# @type=enum(development, production, test)
# @public
NODE_ENV=development
# ビルド時ではなく起動時の値を使う（next start -p / PORT 指定のため）
# @type=port
# @public
# @dynamic
PORT=

# --- Supabase / DB ---
# @type=url
# @required
# @public
NEXT_PUBLIC_SUPABASE_URL=
# @required
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# @type=url(allowedProtocols=[postgres, postgresql])
# @required
DATABASE_URL=
# 開発環境（シード用）のみ使用
SUPABASE_SECRET_KEY=

# --- 認証 ---
# OAuth の client_id は認可URLとして、レスポンスに含まれるのが正常なため、漏洩検知(preventLeaks)の対象から外す
# @required
# @sensitive={preventLeaks=false}
AUTH_GOOGLE_ID=
# @required
AUTH_GOOGLE_SECRET=
# OAuth の client_id は認可URLとして、レスポンスに含まれるのが正常なため、漏洩検知(preventLeaks)の対象から外す
# @required
# @sensitive={preventLeaks=false}
AUTH_DISCORD_ID=
# @required
AUTH_DISCORD_SECRET=
# better-auth の署名用シークレット。Vercel では必須、ローカルでは開発用の固定値
# @required=not(isEmpty($VERCEL))
AUTH_SECRET=if(isEmpty($VERCEL), "auth-secret", "")

# --- R2 Storage（本番のみ必須） ---
# @required=forEnv(production)
R2_ACCOUNT_ID=
# @required=forEnv(production)
R2_ACCESS_KEY_ID=
# @required=forEnv(production)
R2_SECRET_ACCESS_KEY=
# @required=forEnv(production)
R2_BUCKET_NAME=

# --- 外部サービス（Vercel では必須） ---
# @required=not(isEmpty($VERCEL))
GCP_AUTH_KEY=
# @required=not(isEmpty($VERCEL))
VERCEL_PROJECT_ID=
# @required=not(isEmpty($VERCEL))
VERCEL_API_TOKEN=
# @required=not(isEmpty($VERCEL))
SUDACHI_API_KEY=
# @type=url
# @required=not(isEmpty($VERCEL))
SUDACHI_API_URL=
# 運営用 Discord チャンネルの Webhook URL。お問い合わせ・通報があると通知する（任意。未設定なら通知しない）
# @type=url(allowedProtocols=[https], allowedDomains=[discord.com, discordapp.com])
DISCORD_WEBHOOK_URL=

# 開発環境の読み変換用（任意）
YAHOO_APP_ID=

# --- 公開設定 ---
# @type=boolean
NEXT_PUBLIC_MAINTENANCE_MODE=false
